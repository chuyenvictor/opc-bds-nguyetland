  "description": "OPC-BĐS — AI Agentic Real Estate Cashflow Platform & Virtual Office for Nguyệt Land (Đà Nẵng)",
  "type": "module",
  "main": "serve_local.mjs",
  "scripts": {
    "start": "node serve_local.mjs",
    "dev": "node serve_local.mjs",
    "studio": "start http://localhost:8088/studio",
    "scan:trends": "node ../../0_NEWS_TREND/scripts/scan_daily_trends.mjs --category=bds",
    "deploy:pages": "npx wrangler pages deploy . --project-name=opc-bds-nguyetland",
