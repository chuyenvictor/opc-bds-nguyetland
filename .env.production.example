# ==============================================================================
# OPC-BĐS NGUYET LAND — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in ALL values before deploying to production.
# NEVER commit .env with real values to git!
# ==============================================================================

PORT=8088
APP_NAME="NGUYỆT LAND — BĐS Dòng Tiền & Nhà Đẹp Đà Nẵng (OPC-BĐS)"
BRAND_SLOGAN="Người Bản Địa — BĐS Thật — Giá Trị Thật — Dòng Tiền Thật"
TARGET_CITY="Đà Nẵng"
BASE_URL="https://bds.breaths.live"
PUBLIC_DOMAIN="https://bds.breaths.live"
NODE_ENV=production

# ══════════════════════════════════════════════════════════════
# 🔐 SECRETS — REQUIRED (Must change before production!)
# ══════════════════════════════════════════════════════════════

# Admin Authentication
ADMIN_PASSWORD=<THAY_DOI_PASSWORD_ADMIN_MANH>
ADMIN_SECRET_KEY=<THAY_DOI_SECRET_KEY_64_CHARS>
JWT_SECRET=<GENERATE_BANG_LENH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">

# Google AI Studio
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>

# Google Cloud & YouTube Data API v3
YOUTUBE_API_KEY=<YOUR_YOUTUBE_API_KEY>
GCP_PROJECT_ID=opc-bds
GCP_PROJECT_NUMBER=<YOUR_GCP_PROJECT_NUMBER>
SERVICE_ACCOUNT_EMAIL=<YOUR_SERVICE_ACCOUNT>@opc-bds.iam.gserviceaccount.com
GOOGLE_SHEET_ID=<YOUR_GOOGLE_SHEET_ID>
GOOGLE_SHEET_WEBHOOK_URL=<YOUR_APPS_SCRIPT_WEBHOOK_URL>

# Firecrawl Multi-Key Pool
FIRECRAWL_KEY_1=<YOUR_FIRECRAWL_KEY_1>
FIRECRAWL_KEY_2=<YOUR_FIRECRAWL_KEY_2>
FIRECRAWL_KEY_3=<YOUR_FIRECRAWL_KEY_3>

# Telegram Bot
HOTLINE_NGUYET_LAND="0935509168"
ZALO_NGUYET_LAND="https://zalo.me/0935509168"
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>

# Database & Storage
SQLITE_DB_PATH=data/opc_bds.db
OBSIDIAN_VAULT_PATH=<PATH_TO_WIKI_OBSIDIAN_BDS>
AUTO_PIPELINE_CRON="0 7 * * *"

# Firebase Configuration
FIREBASE_API_KEY=<YOUR_FIREBASE_API_KEY>
FIREBASE_AUTH_DOMAIN=<YOUR_PROJECT>.firebaseapp.com
FIREBASE_PROJECT_ID=<YOUR_PROJECT_ID>
FIREBASE_STORAGE_BUCKET=<YOUR_PROJECT>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<YOUR_SENDER_ID>
FIREBASE_APP_ID=<YOUR_APP_ID>
FIREBASE_MEASUREMENT_ID=<YOUR_MEASUREMENT_ID>

# GitHub (Deployment & Backup)
GITHUB_USERNAME=<YOUR_GITHUB_USERNAME>
GITHUB_EMAIL=<YOUR_GITHUB_EMAIL>
GITHUB_REPO_URL=<YOUR_REPO_URL>
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>
